#
# The published image: the static binaries server-release.yml built and
# checked, copied in. Nothing is compiled here -- that was the point of it.
# server/Dockerfile still builds from source, for docker-compose.build.yml.

FROM alpine:3.20
ARG TARGETARCH
RUN apk add --no-cache ca-certificates \
 && adduser -S -D -H -u 10001 xchange \
 && mkdir -p /var/lib/xchange/bundles \
 && chown -R xchange /var/lib/xchange
COPY image-bin/ /tmp/bins/
RUN set -e; \
    case "$TARGETARCH" in amd64) a=x86_64 ;; arm64) a=aarch64 ;; *) echo "unsupported $TARGETARCH"; exit 1 ;; esac; \
    install -m 0755 "/tmp/bins/xchange-server-$a" /usr/local/bin/xchange-server; \
    rm -rf /tmp/bins; \
    xchange-server --version
USER xchange
EXPOSE 8901
CMD ["xchange-server"]
