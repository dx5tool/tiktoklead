{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "XChange",
  "identifier": "dev.xchange.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5273",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/sidecar.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XChange",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5273 ws://127.0.0.1:5273 http://localhost:5273 ws://localhost:5273; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "XChange Browser contributors",
    "category": "Utility",
    "shortDescription": "Anti-detect browser for teams",
    "longDescription": "Self-hosted anti-detect browser with projects, per-project access grants and a shared profile lock.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/xchange-agent"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer/hooks.nsh",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NkRDNjQxNzcyNEQxMjMKUldRajBTUjNRY1p0cFUzNEExVTU1WDZ1RHlpMnQ5WElmS2RlRHhUcWY5UUVEWkNIcEVqSXZjM2oK",
      "endpoints": [
        "https://github.com/dx5tool/tiktoklead/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
