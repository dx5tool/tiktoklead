+// WebRTC candidates, or nullopt when the mode is `off` or the config is
+// incomplete. The addresses never leave JavaScript: the real UDP sockets stay
+// disabled by `disable_non_proxied_udp` (patch 0070), so no packet is sent.
+struct WebRtcFakeCandidates {
+  std::string public_ip;
+  std::string local_ip;
+  uint16_t port;
+};
