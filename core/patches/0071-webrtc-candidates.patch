diff --git a/components/fury/fury_config.cc b/components/fury/fury_config.cc
index 72e603d..01c1a6a 100644
--- a/components/fury/fury_config.cc
+++ b/components/fury/fury_config.cc
@@ -244,4 +244,41 @@ std::optional<std::vector<std::string>> FuryConfig::GetStringList(
   return out;
 }
 
+std::optional<WebRtcFakeCandidates> GetWebRtcFakeCandidates() {
+  const FuryConfig* config = FuryConfig::Get();
+  if (!config) {
+    return std::nullopt;
+  }
+  std::optional<std::string> mode = config->GetString("webrtc.mode");
+  if (!mode || (*mode != "base_on_ip" && *mode != "fixed")) {
+    // `off` is the ordinary state and must not log; an unknown value would
+    // have been refused by the agent before launch, but if one arrives, no
+    // candidate is safer than a made-up one.
+    if (mode && *mode != "off") {
+      LOG(ERROR) << "fury: unknown webrtc.mode=" << *mode
+                 << "; reporting no candidates";
+    }
+    return std::nullopt;
+  }
+  std::optional<std::string> local_ip = config->GetString("webrtc.localIp");
+  std::optional<std::string> public_ip = config->GetString("webrtc.publicIp");
+  if (!local_ip || local_ip->empty() || !public_ip || public_ip->empty()) {
+    LOG(ERROR) << "fury: webrtc.mode=" << *mode
+               << " without both candidate addresses; reporting no candidates";
+    return std::nullopt;
+  }
+
+  // One port for both candidates, stable for one profile: a host and its
+  // server-reflexive sibling share the local port by definition. Derived from
+  // the local address, which is itself derived from the profile seed.
+  uint32_t hash = 2166136261u;
+  for (unsigned char c : *local_ip) {
+    hash ^= c;
+    hash *= 16777619u;
+  }
+  const uint16_t port = static_cast<uint16_t>(49152 + (hash % 16384));
+
+  return WebRtcFakeCandidates{*public_ip, *local_ip, port};
+}
+
 }  // namespace fury
