+void RTCPeerConnection::FuryMaybeSendFakeCandidates() {
+  if (fury_fake_candidates_emitted_) {
+    return;
+  }
+  std::optional<fury::WebRtcFakeCandidates> candidates =
+      fury::GetWebRtcFakeCandidates();
+  if (!candidates) {
+    return;
+  }
+  fury_fake_candidates_emitted_ = true;
+
+  // The ufrag is not part of the address, but a candidate without one next to
+  // a local description that has one is a contradiction a checker can read.
+  std::string ufrag;
+  if (RTCSessionDescription* description = localDescription()) {
+    const std::string sdp = description->sdp().Utf8();
+    constexpr char kUfrag[] = "a=ice-ufrag:";
+    size_t at = sdp.find(kUfrag);
+    if (at != std::string::npos) {
+      const size_t begin = at + sizeof(kUfrag) - 1;
+      const size_t end = sdp.find_first_of("\r\n", begin);
+      if (end != std::string::npos) {
+        ufrag = sdp.substr(begin, end - begin);
+      }
+    }
+  }
+  const std::string suffix =
+      ufrag.empty() ? " generation 0" : " generation 0 ufrag " + ufrag;
+  const String username_fragment =
+      ufrag.empty() ? String() : String::FromUTF8(ufrag.c_str());
+
+  // Real Chrome 155 writes both candidates with the same local port and a
+  // component of 1; these strings carry the shape a page expects, including
+  // the related address on the srflx candidate. Nothing is sent: the policy is
+  // still disable_non_proxied_udp, so the ICE agent has no socket behind them.
+  const std::string host = "candidate:1 1 udp 2122260223 " +
+                           candidates->local_ip + " " +
+                           std::to_string(candidates->port) + " typ host" +
+                           suffix;
+  const std::string srflx = "candidate:2 1 udp 1686052607 " +
+                            candidates->public_ip + " " +
+                            std::to_string(candidates->port) +
+                            " typ srflx raddr " + candidates->local_ip +
+                            " rport " + std::to_string(candidates->port) +
+                            suffix;
+  for (const std::string& candidate : {host, srflx}) {
+    auto* platform_candidate = MakeGarbageCollected<RTCIceCandidatePlatform>(
+        String::FromUTF8(candidate.c_str()), String("0"),
+        std::optional<uint16_t>(0), username_fragment, String());
+    DidGenerateICECandidate(platform_candidate);
+  }
+}
